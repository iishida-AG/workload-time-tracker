rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isWorkloadUser() {
      return request.auth != null
        && request.auth.token.email in [
          'iishida@agentgate.jp',
          'rtagami@agentgate.jp',
          'ag.rtagami@agentgate.jp',
          'ag.rtagami@gmail.com'
        ];
    }

    function isCrmOwner() {
      return request.auth != null
        && request.auth.token.email == 'iishida@agentgate.jp';
    }

    match /workloadApps/default {
      allow read, write: if isWorkloadUser();
    }

    match /companies/{companyId} {
      allow read, create, update, delete: if isCrmOwner();
    }

    match /matchingLogs/{matchingLogId} {
      allow read, create, update, delete: if isCrmOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
